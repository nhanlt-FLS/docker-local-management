[Unit]
Description=Local Docker Management UI (port 8420)
After=network.target docker.socket
Wants=docker.socket

[Service]
Type=simple
WorkingDirectory=/home/nathannhanle/docker_local_management
ExecStart=/usr/bin/python3 /home/nathannhanle/docker_local_management/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
